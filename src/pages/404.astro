---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <section class="nf wrap">
    <img src="/img/mascot-ok.webp" alt="" width="600" height="582" />
    <div>
      <p class="eyebrow">404</p>
      <h1>This plate is empty.</h1>
      <p>The page you wanted isn't here. The biryani is, though.</p>
      <div class="a"><a class="btn" href="/">Back home</a><a class="btn btn--ghost" href="/menu">See the menu</a></div>
    </div>
  </section>
</Base>
<style>
  .nf {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 30px;
    padding-top: var(--nav-h);
  }
  img {
    width: min(100%, 340px);
    justify-self: center;
  }
  h1 {
    font-size: var(--step-4);
    color: var(--maroon-900);
    margin: 14px 0;
  }
  .a {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .btn--ghost {
    color: var(--maroon-900);
  }
  @media (max-width: 700px) {
    .nf {
      grid-template-columns: 1fr;
      text-align: center;
      align-content: center;
    }
    img {
      width: 200px;
    }
    .a {
      justify-content: center;
    }
  }
</style>
