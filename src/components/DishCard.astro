---
// One dish. `variant`: "feature" (big signature tile) | "tile" (signature grid) | "row" (menu list)
import type { Dish } from "../data/menu";
import { rupee, priceLabel } from "../data/menu";
interface Props { dish: Dish; variant?: "feature" | "tile" | "row"; index?: number; image?: string }
const { dish, variant = "row", index, image } = Astro.props;
const dietLabel = { veg: "Vegetarian", egg: "Contains egg", nonveg: "Non-vegetarian" }[dish.diet];
const artFor: Record<string, string> = { soups: "bowl", mutton: "bowl", "indian-main": "bowl", "south-seafood": "bowl", chinese: "bowl", chicken: "pieces", seafood: "pieces", kebabs: "pieces", desserts: "scoop" };
const searchText = [dish.name, dish.tamil, ...(dish.variants?.map((x) => x.label) ?? [])].filter(Boolean).join(" ").toLowerCase();

const art = artFor[dish.category] ?? "plate";
const tagLabel: Record<string, string> = { signature: "Signature", special: "Chef's special", bestseller: "Bestseller", spicy: "Spicy", new: "New" };
---
<article class={`dish dish--${variant}`} data-dish={dish.id} data-diet={dish.diet} data-name={searchText}>
  {variant !== "row" && (
    <div class="dish__art">
      {image ? (
        <img src={image} alt={`${dish.name} at Hotel Pandia's`} loading="lazy" width="900" height="675" />
      ) : (
        <svg viewBox="0 0 200 150" aria-hidden="true" class={`art art--${art}`}>
          {art === "bowl" ? (
            <>
              <ellipse cx="100" cy="112" rx="80" ry="22" class="plate" />
              <path d="M38 78 h124 a62 46 0 0 1 -124 0z" class="bowl" />
              <ellipse cx="100" cy="78" rx="62" ry="14" class="soup" />
              <g class="dots">{Array.from({ length: 7 }).map((_, i) => <circle cx={66 + i * 11} cy={76 + ((i * 7) % 6)} r="3" />)}</g>
            </>
          ) : art === "pieces" ? (
            <>
              <ellipse cx="100" cy="108" rx="86" ry="26" class="plate" />
              <ellipse cx="100" cy="100" rx="70" ry="20" class="plate-in" />
              {Array.from({ length: 6 }).map((_, i) => <ellipse cx={62 + (i % 3) * 36} cy={i < 3 ? 86 : 100} rx="17" ry="11" class="piece" transform={`rotate(${(i * 37) % 50 - 25} ${62 + (i % 3) * 36} ${i < 3 ? 86 : 100})`} />)}
              <g class="leaf">{[0, 1, 2].map((i) => <ellipse cx={70 + i * 30} cy={78 + (i % 2) * 22} rx="6" ry="3" />)}</g>
            </>
          ) : art === "scoop" ? (
            <>
              <path d="M70 70 L100 130 L130 70z" class="cone" />
              <circle cx="100" cy="62" r="30" class="scoop" />
              <circle cx="88" cy="52" r="6" class="shine" />
            </>
          ) : (
            <>
              <ellipse cx="100" cy="108" rx="86" ry="26" class="plate" />
              <ellipse cx="100" cy="100" rx="70" ry="20" class="plate-in" />
              <path d="M42 98 Q100 30 158 98 Z" class="heap" />
              <g class="dots">{Array.from({ length: 26 }).map((_, i) => <ellipse cx={52 + ((i * 41) % 96)} cy={70 + ((i * 17) % 26)} rx="3.4" ry="1.3" transform={`rotate(${(i * 53) % 180} ${52 + ((i * 41) % 96)} ${70 + ((i * 17) % 26)})`} />)}</g>
            </>
          )}
          <path d="M84 40 q-8 -10 0 -20 M100 36 q-8 -12 0 -24 M116 40 q-8 -10 0 -20" class="steam" />
        </svg>
      )}
      {index !== undefined && <span class="dish__no">{String(index + 1).padStart(2, "0")}</span>}
    </div>
  )}
  <div class="dish__body">
    <div class="dish__head">
      <span class={`diet diet--${dish.diet}`} title={dietLabel}><span class="sr-only">{dietLabel}</span></span>
      <h3>{dish.name}</h3>
      {variant === "row" && <span class="dish__dots" aria-hidden="true"></span>}
      <span class={`dish__price ${priceLabel(dish) === "Seasonal" ? "dish__price--seasonal" : ""}`}>{priceLabel(dish)}</span>
    </div>
    {dish.tamil && variant !== "row" && <p class="dish__tamil tamil">{dish.tamil}</p>}
    {dish.desc && <p class="dish__desc">{dish.desc}</p>}
    {dish.variants && dish.variants.length > 2 && (
      <ul class="dish__vars">
        {dish.variants.map((x) => <li><span>{x.label}</span><b>{x.price === null ? "Seasonal" : rupee(x.price)}</b></li>)}
      </ul>
    )}
    {dish.variants && dish.variants.length === 2 && <p class="dish__pair">{dish.variants.map((x) => x.label).join(" / ")}</p>}
    {dish.tags && dish.tags.length > 0 && (
      <ul class="dish__tags">{dish.tags.map((t) => <li class={`tag tag--${t}`}>{tagLabel[t]}</li>)}</ul>
    )}
    <slot />
  </div>
</article>

<style>
  .dish {
    position: relative;
  }
  .dish__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .dish__head .diet {
    align-self: center;
  }
  h3 {
    font-size: 1.18rem;
    font-weight: 620;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .dish__dots {
    flex: 1;
    border-bottom: 2px dotted color-mix(in oklab, var(--ink) 25%, transparent);
    transform: translateY(-4px);
    min-width: 20px;
  }
  .dish__price {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--red-700);
    margin-left: auto;
    white-space: nowrap;
  }
  .dish__desc {
    color: var(--text-soft);
    font-size: 0.95rem;
    margin-top: 6px;
    max-width: 46ch;
  }
  .dish__price--seasonal {
    color: var(--text-soft);
    font-weight: 500;
    font-style: italic;
  }
  .dish__vars {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .dish__vars li {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.82rem;
  }
  .dish__vars b {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--red-700);
    font-size: 0.78rem;
  }
  .dish__pair {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-top: 4px;
  }
  .tag--special {
    background: color-mix(in oklab, var(--red-600) 14%, transparent);
    color: var(--red-700);
  }
  .dish__tamil {
    color: var(--red-700);
    font-size: 0.95rem;
    margin-top: 2px;
  }
  .dish__tags {
    list-style: none;
    display: flex;
    gap: 6px;
    padding: 0;
    margin: 10px 0 0;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--cream-200);
    color: var(--maroon-800);
  }
  .tag--signature {
    background: var(--maroon-900);
    color: var(--gold-300);
  }
  .tag--spicy {
    background: #fde0d6;
    color: #b0251a;
  }
  .tag--bestseller {
    background: #fbe7b4;
    color: #7a4a00;
  }

  /* row */
  .dish--row {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  /* tiles */
  .dish--tile,
  .dish--feature {
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .dish--tile:hover,
  .dish--feature:hover {
    transform: translateY(-6px) rotate(-0.4deg);
    box-shadow: var(--shadow-pop);
  }
  .dish__art {
    position: relative;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 50% 60%, #ffe2a6, transparent 62%),
      repeating-conic-gradient(from 0deg at 50% 60%, #f7ddb0 0 6deg, #f3d39f 6deg 12deg);
    overflow: hidden;
  }
  .dish__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .dish:hover .dish__art img,
  .dish:hover .dish__art svg {
    transform: scale(1.05);
  }
  .dish__art svg {
    width: 100%;
    height: 100%;
    transition: transform 1.2s var(--ease-out);
  }
  .plate {
    fill: var(--gold-500);
  }
  .plate-in {
    fill: var(--gold-300);
  }
  .heap {
    fill: #f2b43a;
  }
  .dots ellipse {
    fill: #fff3d6;
  }
  .bowl {
    fill: var(--red-700);
  }
  .soup {
    fill: #c8691e;
  }
  .art--bowl .dots circle {
    fill: #f6d58e;
  }
  .piece {
    fill: #9a4517;
    stroke: #6e2d0c;
    stroke-width: 2;
  }
  .leaf ellipse {
    fill: #4f9a3a;
  }
  .cone {
    fill: #d9a35a;
  }
  .scoop {
    fill: #f7e0c4;
  }
  .shine {
    fill: #fff;
    opacity: 0.6;
  }
  .art--scoop + .steam,
  .art--scoop .steam {
    display: none;
  }
  .steam {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.8;
    animation: steam 3s ease-in-out infinite;
  }
  @keyframes steam {
    50% {
      transform: translateY(-5px);
      opacity: 0.35;
    }
  }
  .dish__no {
    position: absolute;
    top: 14px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--cream-50);
    color: var(--maroon-900);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .dish--tile .dish__body,
  .dish--feature .dish__body {
    padding: 18px 20px 22px;
  }
  .dish--feature h3 {
    font-size: var(--step-2);
    font-family: var(--font-display);
  }
  .dish--feature .dish__price {
    font-size: 1.15rem;
  }
</style>
