---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { reviews, branches, site } from "../data/site";
const rated = branches.filter((b) => b.rating);
---
<section class="rev">
  <div class="wrap">
    <SectionHead eyebrow="What people say" title="Chennai keeps <em>coming back.</em>" align="center" tone="dark" />
    <div class="rev__scores" data-reveal>
      {rated.map((b) => (
        <div class="score">
          <strong>{b.rating!.value.toFixed(1)}<Icon name="star" /></strong>
          <span>{b.name} on {b.rating!.source}</span>
        </div>
      ))}
    </div>
    <div class="rev__grid">
      {reviews.map((r, i) => (
        <figure class="quote" data-reveal style={`--d:${i * 0.08}s;--r:${[-1.2, 0.8, -0.6, 1.1][i % 4]}deg`}>
          <blockquote>“{r.quote}”</blockquote>
          <figcaption><b>{r.name}</b><span>{r.source}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="rev__cta" data-reveal>
      Eaten with us? <a href={site.social.zomato} target="_blank" rel="noopener">Leave a review</a>. It helps more than you think.
    </p>
  </div>
</section>
<style>
  .rev {
    background: var(--maroon-900);
    color: var(--cream-100);
    padding: clamp(80px, 11vw, 140px) 0;
    position: relative;
    overflow: hidden;
  }
  .rev::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(50% 60% at 50% 0%, rgb(232 176 74 / 0.18), transparent 70%);
  }
  .rev .wrap {
    position: relative;
  }
  .rev__scores {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: -10px 0 44px;
  }
  .score {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.1);
    padding: 10px 18px 10px 12px;
    border-radius: 999px;
  }
  .score strong {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--gold-500);
    color: var(--maroon-900);
    border-radius: 999px;
    padding: 4px 10px;
    font-family: var(--font-mono);
  }
  .score :global(svg) {
    width: 14px;
  }
  .score span {
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .rev__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .quote {
    margin: 0;
    background: var(--cream-50);
    color: var(--ink);
    border-radius: var(--radius);
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    rotate: var(--r);
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.6);
    transition: rotate 0.5s var(--ease-spring), translate 0.5s var(--ease-spring);
  }
  .quote:hover {
    rotate: 0deg;
    translate: 0 -6px;
  }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.22rem;
    line-height: 1.3;
    font-weight: 500;
  }
  figcaption {
    display: grid;
    font-size: 0.85rem;
  }
  figcaption span {
    color: var(--text-soft);
  }
  .rev__cta {
    text-align: center;
    margin-top: 44px;
    opacity: 0.85;
  }
  .rev__cta a {
    color: var(--gold-300);
  }
  @media (max-width: 1000px) {
    .rev__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .rev__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
