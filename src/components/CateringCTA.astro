---
import Icon from "./Icon.astro";
import { waLink } from "../data/site";
---
<section class="cta">
  <div class="wrap cta__inner">
    <div class="cta__copy" data-reveal>
      <p class="eyebrow">Weddings · Office lunches · Family functions</p>
      <h2>Feeding a crowd? <em>Bring the biryani man.</em></h2>
      <p>Tell us the date, the headcount and the dishes. We'll get back to you with a quote.</p>
      <div class="cta__actions">
        <a class="btn btn--gold" href={waLink("Hi Pandia's! I'd like a catering quote.\nDate:\nHeadcount:\nDishes:")} target="_blank" rel="noopener"><Icon name="whatsapp" /> Get a catering quote</a>
        <a class="btn btn--ghost" href="/branches#book">Book a table</a>
      </div>
    </div>
    <div class="cta__art" data-reveal style="--d:.1s">
      <div class="steamy">
        <img src="/img/mascot-ok-nosteam.webp" alt="The Hotel Pandia's biryani man doing a perfect sign" width="600" height="582" loading="lazy" />
        <!-- live steam over the plate (drawn in the image's own 600×582 space, so it stays on the biryani at any size) -->
        <svg class="cta-steam" viewBox="0 0 600 582" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="cta-steam" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0" />
              <stop offset="0.25" stop-color="#fff" stop-opacity="0.9" />
              <stop offset="0.7" stop-color="#fff" stop-opacity="0.55" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g class="steam__sway"><path class="steam__wisp" d="M50 268 c-13 -21 13 -40 0 -61 s13 -40 0 -61" /></g>
          <g class="steam__sway" style="--steam-sway:4.6s;--steam-x:-5px"><path class="steam__wisp" style="--steam-dur:3.8s;--steam-delay:-1.4s" d="M71 270 c-12 -22 12 -42 0 -64 s12 -42 0 -64" /></g>
          <g class="steam__sway" style="--steam-sway:5.4s;--steam-x:7px"><path class="steam__wisp" style="--steam-dur:3.4s;--steam-delay:-2.6s;--steam-w:7" d="M92 266 c-11 -19 11 -36 0 -55 s11 -36 0 -55" /></g>
        </svg>
      </div>
    </div>
  </div>
</section>
<style>
  .cta {
    padding: clamp(40px, 6vw, 80px) 0;
  }
  .cta__inner {
    background:
      radial-gradient(70% 90% at 85% 60%, rgb(232 176 74 / 0.35), transparent 60%),
      linear-gradient(135deg, var(--red-600), var(--red-700) 60%, var(--maroon-800));
    border-radius: calc(var(--radius) * 1.6);
    color: var(--cream-50);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    overflow: hidden;
    position: relative;
  }
  .cta__copy {
    padding: clamp(32px, 6vw, 80px);
  }
  .eyebrow {
    color: var(--gold-300);
  }
  h2 {
    font-size: var(--step-4);
    margin: 16px 0 18px;
  }
  h2 em {
    color: var(--gold-300);
  }
  .cta__copy > p:not(.eyebrow) {
    font-size: var(--step-1);
    max-width: 32rem;
    opacity: 0.9;
  }
  .cta__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .cta__art {
    align-self: end;
  }
  /* the box keeps the image's exact shape, so the steam overlay lines up with the plate */
  .steamy {
    position: relative;
    width: min(100%, 536px); /* 520px tall at most */
    margin-left: auto;
  }
  .steamy img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35));
  }
  .cta-steam {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .steam__wisp {
    fill: none;
    stroke: url(#cta-steam);
    stroke-width: var(--steam-w, 9);
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: steam-rise var(--steam-dur, 3.2s) var(--steam-delay, 0s) ease-out infinite;
  }
  .steam__sway {
    transform-box: fill-box;
    animation: steam-sway var(--steam-sway, 4s) ease-in-out infinite alternate;
  }
  @keyframes steam-rise {
    0% {
      transform: translateY(12px) scaleY(0.7);
      opacity: 0;
    }
    25% {
      opacity: 0.8;
    }
    70% {
      opacity: 0.45;
    }
    100% {
      transform: translateY(-44px) scaleY(1.12);
      opacity: 0;
    }
  }
  @keyframes steam-sway {
    from {
      transform: translateX(calc(var(--steam-x, 6px) * -1));
    }
    to {
      transform: translateX(var(--steam-x, 6px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam__wisp,
    .steam__sway {
      animation: none;
      opacity: 0.55;
    }
  }
  @media (max-width: 800px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
    .cta__art {
      max-width: 300px;
      margin: -20px auto 0;
    }
    .steamy {
      margin-inline: auto;
    }
  }
</style>
