---
// Full menu with sticky category bar, veg-only toggle and search.
// mode="order" adds add/remove steppers to every dish (used on /order).
import DishCard from "./DishCard.astro";
import Icon from "./Icon.astro";
import { categories, byCategory, HAS_DRAFT_PRICES, orderOptions, rupee } from "../data/menu";
interface Props { mode?: "browse" | "order" }
const { mode = "browse" } = Astro.props;
const cats = categories.filter((c) => byCategory(c.id).length);
---
<div class={`mb mb--${mode}`} data-menu>
  <div class="mb__bar">
    <div class="mb__tools">
      <label class="mb__search">
        <Icon name="search" />
        <span class="sr-only">Search the menu</span>
        <input type="search" placeholder="Search biryani, parotta, soup…" data-search autocomplete="off" />
      </label>
      <label class="mb__veg">
        <input type="checkbox" data-veg />
        <span class="mb__switch" aria-hidden="true"></span>
        <span class="diet diet--veg" aria-hidden="true"></span> Veg only
      </label>
    </div>
    <nav class="mb__cats" aria-label="Menu categories" data-cats>
      {cats.map((c) => <a href={`#${c.id}`} data-cat-link={c.id}>{c.name}</a>)}
    </nav>
  </div>

  <div class="mb__list">
    {cats.map((c) => (
      <section class="mb__cat" id={c.id} data-cat={c.id} aria-labelledby={`h-${c.id}`}>
        <header>
          <h2 id={`h-${c.id}`}>{c.name}</h2>
          <p>{c.blurb}</p>
        </header>
        <div class="mb__dishes">
          {byCategory(c.id).map((d) => (
            <DishCard dish={d} variant="row">
              {mode === "order" && (orderOptions(d).length === 0 ? (
                <p class="step__seasonal">Seasonal price. Ask your server.</p>
              ) : (
                <div class="steps">
                  {orderOptions(d).map((o) => (
                    <div class={`step ${o.label ? "step--var" : ""}`} data-step={o.key} data-price={o.price} data-name={o.name}>
                      {o.label && <span class="step__label">{o.label} <b>{rupee(o.price)}</b></span>}
                      <button type="button" class="step__add" data-add aria-label={`Add ${o.name}`}><Icon name="plus" /> Add</button>
                      <div class="step__ctrl" hidden>
                        <button type="button" data-dec aria-label={`Remove one ${o.name}`}><Icon name="minus" /></button>
                        <output data-qty>0</output>
                        <button type="button" data-inc aria-label={`Add one more ${o.name}`}><Icon name="plus" /></button>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </DishCard>
          ))}
        </div>
      </section>
    ))}
    <p class="mb__empty" data-empty hidden>Nothing matches that. Try “biryani” or “parotta”.</p>
    {HAS_DRAFT_PRICES && <p class="mb__note">Prices are being updated and may differ slightly in the restaurant. Taxes extra.</p>}
  </div>
</div>

<style>
  .mb__bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 12px 0 0;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--line);
    transition: top 0.5s var(--ease-out);
  }
  :global(.nav:not(.is-hidden) ~ main) .mb--browse .mb__bar {
    top: var(--nav-h);
  }
  .mb__tools {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .mb__search {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border-radius: 999px;
    padding: 0 16px;
    border: 1.5px solid var(--line);
    min-height: 46px;
  }
  .mb__search:focus-within {
    border-color: var(--gold-500);
  }
  .mb__search :global(svg) {
    width: 18px;
    color: var(--text-soft);
  }
  .mb__search input {
    flex: 1;
    border: 0;
    background: none;
    outline: none;
    min-width: 0;
    height: 44px;
  }
  .mb__veg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
  }
  .mb__veg input {
    position: absolute;
    opacity: 0;
  }
  .mb__switch {
    width: 40px;
    height: 24px;
    border-radius: 999px;
    background: var(--cream-200);
    position: relative;
    transition: background 0.3s;
  }
  .mb__switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform 0.35s var(--ease-spring);
  }
  .mb__veg input:checked + .mb__switch {
    background: var(--leaf);
  }
  .mb__veg input:checked + .mb__switch::after {
    transform: translateX(16px);
  }
  .mb__veg input:focus-visible + .mb__switch {
    outline: 3px solid var(--gold-500);
    outline-offset: 2px;
  }
  .mb__cats {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 10px 0;
    scroll-behavior: smooth;
  }
  .mb__cats::-webkit-scrollbar {
    display: none;
  }
  .mb__cats a {
    flex: none;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 7px 14px;
    border-radius: 999px;
    color: var(--text-soft);
    transition: all 0.25s;
  }
  .mb__cats a.on {
    background: var(--maroon-900);
    color: var(--gold-300);
  }
  .mb__cat {
    padding-top: 30px;
    scroll-margin-top: calc(var(--nav-h) + 120px);
  }
  .mb__cat header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .mb__cat h2 {
    font-size: var(--step-3);
    color: var(--maroon-900);
  }
  .mb__cat header p {
    color: var(--red-700);
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 85%;
  }
  .mb__dishes {
    columns: 2;
    column-gap: 56px;
  }
  .mb__dishes > :global(*) {
    break-inside: avoid;
  }
  .mb__empty,
  .mb__note {
    padding: 40px 0 0;
    color: var(--text-soft);
    text-align: center;
  }
  .mb__note {
    font-size: 0.85rem;
  }
  :global([data-hidden]) {
    display: none !important;
  }

  /* steppers (order mode) */
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .step {
    display: flex;
    align-items: center;
  }
  .step--var {
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 3px 3px 12px;
    background: var(--surface);
  }
  .step__label {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .step__label b {
    font-family: var(--font-mono);
    color: var(--red-700);
    font-size: 0.8rem;
    margin-left: 2px;
  }
  .step--var .step__add,
  .step--var .step__ctrl {
    min-height: 34px;
  }
  .step--var .step__add {
    padding: 0 12px;
  }
  .step--var .step__ctrl button {
    width: 34px;
    height: 34px;
  }
  .step__seasonal {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .mb--order :global(.dish__vars) {
    display: none;
  }
  .step__add,
  .step__ctrl {
    min-height: 40px;
    border-radius: 999px;
  }
  .step__add {
    border: 1.5px solid var(--red-600);
    color: var(--red-600);
    background: var(--surface);
    padding: 0 16px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .step__add :global(svg),
  .step__ctrl :global(svg) {
    width: 16px;
  }
  .step__ctrl {
    display: inline-flex;
    align-items: center;
    background: var(--red-600);
    color: #fff;
    overflow: hidden;
  }
  .step__ctrl[hidden],
  .step__add[hidden] {
    display: none;
  }
  .step__ctrl button {
    width: 42px;
    height: 40px;
    border: 0;
    background: none;
    color: inherit;
    display: grid;
    place-items: center;
  }
  .step__ctrl output {
    min-width: 22px;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .mb--order .mb__dishes {
    columns: 1;
  }
  @media (max-width: 820px) {
    .mb__dishes {
      columns: 1;
    }
  }
  @media (max-width: 480px) {
    .mb__veg {
      font-size: 0.85rem;
    }
    .mb__veg .diet {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-menu]").forEach((root) => {
    const search = root.querySelector<HTMLInputElement>("[data-search]")!;
    const veg = root.querySelector<HTMLInputElement>("[data-veg]")!;
    const sections = [...root.querySelectorAll<HTMLElement>("[data-cat]")];
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-cat-link]")];
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      sections.forEach((s) => {
        let n = 0;
        s.querySelectorAll<HTMLElement>("[data-dish]").forEach((d) => {
          const ok = (!veg.checked || d.dataset.diet === "veg") && (!q || d.dataset.name!.includes(q));
          d.toggleAttribute("data-hidden", !ok);
          if (ok) n++;
        });
        s.toggleAttribute("data-hidden", n === 0);
        links.find((l) => l.dataset.catLink === s.dataset.cat)?.toggleAttribute("data-hidden", n === 0);
        shown += n;
      });
      empty.hidden = shown > 0;
    };
    search.addEventListener("input", apply);
    veg.addEventListener("change", apply);

    // highlight the category in view
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).dataset.cat;
          links.forEach((l) => {
            const on = l.dataset.catLink === id;
            l.classList.toggle("on", on);
            if (on) l.scrollIntoView({ block: "nearest", inline: "center", behavior: "smooth" });
          });
        }
      },
      { rootMargin: "-30% 0px -60% 0px" }
    );
    sections.forEach((s) => io.observe(s));
  });
</script>
